{
  "_globals": {},
  "s24_sm8650": {
    "repo": "GITHUB_OWNER/android_kernel_samsung_sm8650",
    "defconfig": "defconfig",
    "localversion_base": "-android14-ReSukiSU-SM8650",
    "lto": "none",
    "supported_ksu": [
      "resukisu"
    ],
    "readme_placeholders": {
      "DEVICE_NAME_CN": "三星 Galaxy S24 骁龙系列",
      "DEVICE_NAME_EN": "Samsung Galaxy S24 Snapdragon Series"
    },
    "toolchain_urls": [
      "https://github.com/YuzakiKokuban/android_kernel_samsung_sm8650/releases/download/toolchain/toolchainS24.tar.gz.00",
      "https://github.com/YuzakiKokuban/android_kernel_samsung_sm8650/releases/download/toolchain/toolchainS24.tar.gz.01"
    ],
    "toolchain_path_prefix": "prebuilts",
    "toolchain_path_exports": [
      "build-tools/linux-x86/bin",
      "build-tools/path/linux-x86",
      "clang/host/linux-x86/clang-r487747c/bin",
      "kernel-build-tools/linux-x86/bin"
    ],
    "anykernel_config": "pineapple",
    "zip_name_prefix": "S24_ReSukiSU_Kernel",
    "susfs": {
      "repo": "https://gitlab.com/simonpunk/susfs4ksu.git",
      "branch": "gki-android14-6.1",
      "patch_path": "kernel_patches/50_add_susfs_in_gki-android14-6.1.patch",
      "fs_patch_dir": "kernel_patches/fs",
      "include_linux_patch_dir": "kernel_patches/include/linux"
    },
    "bbg": {
      "setup_url": "https://github.com/vc-teahouse/Baseband-guard/raw/main/setup.sh"
    },
    "disable_security": [
      "UH",
      "RKP",
      "KDP",
      "SECURITY_DEFEX",
      "INTEGRITY",
      "FIVE"
    ]
  }
}
